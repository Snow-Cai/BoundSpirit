  m_Script: {fileID: 11500000, guid: 463efc00e4760a0448b5b3272a98563c, type: 3}
  m_Name: Ghost1Need
  m_EditorClassIdentifier: BoundSpiritRuntime::DialogueAsset
  dialogueID: Ghost1Need
  lines:
  - speakerName: Nice Ghost
    dialogueText: ...You can see me?
    voiceClip: {fileID: 0}
  - speakerName: Nice Ghost
    dialogueText: It has been so long since anyone stopped here.
    voiceClip: {fileID: 0}
  - speakerName: Nice Ghost
    dialogueText: "I used to leave roses here\u2026 every spring. But I cannot touch
      them anymore."
    voiceClip: {fileID: 0}
  - speakerName: Nice Ghost
    dialogueText: "If you happen to find a rose in this place\u2026 could you bring
      it to me? "
    voiceClip: {fileID: 0}
  choices: []
  choicesAfterLineIndex: -1
  saveAfterDialogue: 1
  showChoicesAtEnd: 1
