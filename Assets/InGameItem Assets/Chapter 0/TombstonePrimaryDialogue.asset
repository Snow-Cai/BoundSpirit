  m_Script: {fileID: 11500000, guid: 463efc00e4760a0448b5b3272a98563c, type: 3}
  m_Name: TombstonePrimaryDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueAsset
  dialogueID: Chapter0_tombstone_primary
  lines:
  - speakerName: ???
    dialogueText: Wait... this tombstone. Let me read it closer...
    voiceClip: {fileID: 0}
  - speakerName: ???
    dialogueText: "Akila... that's... that's my name. But why is it on a\u2014"
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: No. No, no, no. This can't be right.
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: I'm... I'm dead? How? When? I don't remember anything...
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: My hands... I can see through them. I really am... a ghost.
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: What happened to me? How did I die? I need to remember...
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: There's something... unfinished. I can feel it. Something keeping
      me here.
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: I have to find out what happened. I have to remember.
    voiceClip: {fileID: 0}
  choices: []
  choicesAfterLineIndex: -1
  saveAfterDialogue: 1
  showChoicesAtEnd: 1
