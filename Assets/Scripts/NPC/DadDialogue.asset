  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 463efc00e4760a0448b5b3272a98563c, type: 3}
  m_Name: DadDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueAsset
  dialogueID: Chapter2_dad
  lines:
  - speakerName: Dad
    dialogueText: '*Hmmm hmm* Heavens, it''s too cold in this damned house!'
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: He's singing my favorite song.
    voiceClip: {fileID: 0}
  - speakerName: Dad
    dialogueText: ...And Linda always nags me about closing the windows. Maybe I
      should listen to her more. Especially now that-
    voiceClip: {fileID: 0}
  - speakerName: Dad
    dialogueText: ...
    voiceClip: {fileID: 0}
  - speakerName: Dad
    dialogueText: My bunny, I miss you.
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: I miss you too, Dad.
    voiceClip: {fileID: 0}
  - speakerName: Dad
    dialogueText: I need to find her password. I can't have her name be tainted.
      She needs to rest in peace.
    voiceClip: {fileID: 0}
  choices: []
  choicesAfterLineIndex: -1
  saveAfterDialogue: 1
  showChoicesAtEnd: 1
