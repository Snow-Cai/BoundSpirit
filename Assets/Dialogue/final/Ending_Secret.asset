MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 463efc00e4760a0448b5b3272a98563c, type: 3}
  m_Name: Ending_Secret
  m_EditorClassIdentifier: BoundSpiritRuntime::DialogueAsset
  dialogueID: ending_secret
  lines:
  - speakerName: Akila
    dialogueText: There's somewhere else I need to go.
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: I keep thinking about that portal. Something keeps pulling me back
      to it. Like it knows something I don't.
    voiceClip: {fileID: 0}
  - speakerName: Eden
    dialogueText: Akila. I wondered if you'd come here.
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: You're dead?
    voiceClip: {fileID: 0}
  - speakerName: Eden
    dialogueText: Yes. Not because of you. Something else, years later. But I got
      here and couldn't move on either. I've been waiting.
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: For what?
    voiceClip: {fileID: 0}
  - speakerName: Eden
    dialogueText: To say - I forgive you. And I'm sorry I never told you I was scared.
      I should have talked to you. I didn't know how. Neither of us knew how.
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: I'm sorry too. For all of it. I understand now what I did.
    voiceClip: {fileID: 0}
  choices: []
  choicesAfterLineIndex: -1
  saveAfterDialogue: 1
  showChoicesAtEnd: 1
