  dialogueID: Chapter2_paranormalBook
  lines:
  - speakerName: Akila
    dialogueText: Hmm... This book seems to be about paranormal activity.
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: Oh! "Ghosts can travel between rooms in different ways, but they
      cannot pass through walls as expected."
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: '"They can however interact with certain objects if they carry
      some relevance to that person." '
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: That kind of explains some stuff...
    voiceClip: {fileID: 0}
  choices: []
  choicesAfterLineIndex: -1
