  m_Script: {fileID: 11500000, guid: 463efc00e4760a0448b5b3272a98563c, type: 3}
  m_Name: Chapter3_filesReaction
  m_EditorClassIdentifier: BoundSpiritRuntime::DialogueAsset
  dialogueID: Chapter3_filesReaction
  lines:
  - speakerName: Akila
    dialogueText: The files say Eden was defending herself. That I followed her.
      That I had a weapon.
    voiceClip: {fileID: 0}
  choices:
  - choiceText: ...I did this. I brought the knife. She was afraid of me.
    nextDialogue: {fileID: 0}
    requiredFlags: []
    forbiddenFlags: []
    onChoiceSelectedID: Files_FullAcceptance
  - choiceText: I don't understand. I loved her. How did it come to this?
    nextDialogue: {fileID: 0}
    requiredFlags: []
    forbiddenFlags: []
    onChoiceSelectedID: Files_PartialAcceptance
  - choiceText: This doesn't make sense. The files must be wrong.
    nextDialogue: {fileID: 0}
    requiredFlags: []
    forbiddenFlags: []
    onChoiceSelectedID: Files_Denial
  choicesAfterLineIndex: -1
  saveAfterDialogue: 1
  showChoicesAtEnd: 1
