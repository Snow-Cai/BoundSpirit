  dialogueID: Chapter2_cipherReaction
  lines:
  - speakerName: Akila
    dialogueText: 'File? Is this connected to dad''s police job? I need to get to
      the bottom of this. '
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: I should go to the police station. I can find more answers there.
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: I wonder...
    voiceClip: {fileID: 0}
  choices:
  - choiceText: The truth might be harder than I want it to be.
    nextDialogue: {fileID: 0}
    requiredFlags: []
    forbiddenFlags: []
    onChoiceSelectedID: Cipher_OpenMinded
  - choiceText: Finally. Proof of what really happened.
    nextDialogue: {fileID: 0}
    requiredFlags: []
    forbiddenFlags: []
    onChoiceSelectedID: Cipher_Deflect
