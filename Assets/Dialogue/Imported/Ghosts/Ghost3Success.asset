  m_Script: {fileID: 11500000, guid: 463efc00e4760a0448b5b3272a98563c, type: 3}
  m_Name: Ghost3Success
  m_EditorClassIdentifier: BoundSpiritRuntime::DialogueAsset
  dialogueID: Ghost3Success
  lines:
  - speakerName: Restless Ghost
    dialogueText: ...Yes. This is the one.
    voiceClip: {fileID: 0}
  - speakerName: Restless Ghost
    dialogueText: "The sound it made when it turned\u2026 I remember now."
    voiceClip: {fileID: 0}
  - speakerName: Restless Ghost
    dialogueText: The symbol I saw that night. It was not the first or the second.
    voiceClip: {fileID: 0}
  - speakerName: Restless Ghost
    dialogueText: That symbol was a square.
    voiceClip: {fileID: 0}
