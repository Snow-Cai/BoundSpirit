  m_Script: {fileID: 11500000, guid: 463efc00e4760a0448b5b3272a98563c, type: 3}
  m_Name: Ghost2Need
  m_EditorClassIdentifier: BoundSpiritRuntime::DialogueAsset
  dialogueID: Ghost2Need
  lines:
  - speakerName: Wandering Ghost
    dialogueText: ...You can hear me too?
    voiceClip: {fileID: 0}
  - speakerName: Wandering Ghost
    dialogueText: I remember holding something tightly in my hands.
    voiceClip: {fileID: 0}
  - speakerName: Wandering Ghost
    dialogueText: "It was fragile\u2026 thin\u2026 and covered in words."
    voiceClip: {fileID: 0}
  - speakerName: Wandering Ghost
    dialogueText: The wind kept trying to steal it from me so I had to crush it in
      my fist.
    voiceClip: {fileID: 0}
  - speakerName: Wandering Ghost
    dialogueText: "If you happen to find something like that nearby\u2026 would you
      bring it here?"
    voiceClip: {fileID: 0}
  choices: []
  choicesAfterLineIndex: -1
  saveAfterDialogue: 1
  showChoicesAtEnd: 1
