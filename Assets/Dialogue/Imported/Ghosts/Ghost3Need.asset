  m_Script: {fileID: 11500000, guid: 463efc00e4760a0448b5b3272a98563c, type: 3}
  m_Name: Ghost3Need
  m_EditorClassIdentifier: BoundSpiritRuntime::DialogueAsset
  dialogueID: Ghost3Need
  lines:
  - speakerName: Restless Ghost
    dialogueText: ...This place used to hold something important.
    voiceClip: {fileID: 0}
  - speakerName: Restless Ghost
    dialogueText: "I remember trying to leave\u2026 but something was locked."
    voiceClip: {fileID: 0}
  - speakerName: Restless Ghost
    dialogueText: There was a small piece of cold metal in my hand.
    voiceClip: {fileID: 0}
  - speakerName: Restless Ghost
    dialogueText: "It fit perfectly into something\u2026 but I cannot remember what."
    voiceClip: {fileID: 0}
  - speakerName: Restless Ghost
    dialogueText: "If you find something like that\u2026 would you bring it to me?"
    voiceClip: {fileID: 0}
  choices: []
  choicesAfterLineIndex: -1
  saveAfterDialogue: 1
  showChoicesAtEnd: 1
