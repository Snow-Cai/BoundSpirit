  dialogueID: Chapter3_stationAlarmEvent
  lines:
  - speakerName: Akila
    dialogueText: Uh oh. The alarm is going off... But surely I can't get in trouble
      as a ghost, right?
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: There does appear to be some kind of code on the computer screens...
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: Maybe I could enter it as a passcode somewhere to find the police
      file I'm looking for.
    voiceClip: {fileID: 0}
  choices: []
  choicesAfterLineIndex: -1
  saveAfterDialogue: 1
  showChoicesAtEnd: 1
