  m_Script: {fileID: 11500000, guid: 463efc00e4760a0448b5b3272a98563c, type: 3}
  m_Name: Chapter3_trashCan
  m_EditorClassIdentifier: Assembly-CSharp::DialogueAsset
  dialogueID: Chapter3_trashCan
  lines:
  - speakerName: Akila
    dialogueText: There's a newspaper in this trash can... The front article is talking
      about a local girl murdered in a peaceful town.
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: Wait, I think this is about me! It was published in 2019...  Most
      of the story was smudged, seemingly by a coffee spill.
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: So what really went down?
    voiceClip: {fileID: 0}
  choices: []
  choicesAfterLineIndex: -1
  saveAfterDialogue: 1
  showChoicesAtEnd: 1
