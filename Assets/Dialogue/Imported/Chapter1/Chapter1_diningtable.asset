  m_Script: {fileID: 11500000, guid: 463efc00e4760a0448b5b3272a98563c, type: 3}
  m_Name: Chapter1_diningtable
  m_EditorClassIdentifier: Assembly-CSharp::DialogueAsset
  dialogueID: 
  lines:
  - speakerName: Akila
    dialogueText: Looks like my parents got rid of my chair.
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: I used to sit here and eat dinner all the time.
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: It was embarassing seeing my old bike photo on the wall while I
      ate, so I would sit with my back facing the wall.
    voiceClip: {fileID: 0}
