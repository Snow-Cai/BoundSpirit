  m_Script: {fileID: 11500000, guid: 463efc00e4760a0448b5b3272a98563c, type: 3}
  m_Name: Ending_Revenge
  m_EditorClassIdentifier: BoundSpiritRuntime::DialogueAsset
  dialogueID: ending_revenge
  lines:
  - speakerName: Akila
    dialogueText: You took everything from me.
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: You took my life. I know what the files say. But you're the one
      still alive. You get to go home, grow up.
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: And I'm stuck here. That's not fair. That will never be right.
    voiceClip: {fileID: 0}
  choices: []
  choicesAfterLineIndex: -1
  saveAfterDialogue: 1
  showChoicesAtEnd: 1
