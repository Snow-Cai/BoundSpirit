MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 463efc00e4760a0448b5b3272a98563c, type: 3}
  m_Name: Chapter4_hillChoice
  m_EditorClassIdentifier: BoundSpiritRuntime::DialogueAsset
  dialogueID: Chapter4_hillChoice
  lines:
  - speakerName: Akila
    dialogueText: This is where I ended.
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: 'I''ve been blaming Eden this whole time. '
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: Since I woke up, I kept thinking - something was done to me. I
      was a victim.
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: 'But I walked up this hill with a knife. She was defending herself. '
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: And all I could think about was how much I loved her. I thought
      love made it okay.
    voiceClip: {fileID: 0}
  - speakerName: Akila
    dialogueText: Eden. I don't know if you can hear me. But I need to say something.
    voiceClip: {fileID: 0}
  choices:
  - choiceText: I'm sorry
    nextDialogue: {fileID: 0}
    requiredFlags: []
    forbiddenFlags: []
    onChoiceSelected:
      m_PersistentCalls:
        m_Calls: []
  - choiceText: You took everything
    nextDialogue: {fileID: 0}
    requiredFlags: []
    forbiddenFlags: []
    onChoiceSelected:
      m_PersistentCalls:
        m_Calls: []
  - choiceText: I need to go
    nextDialogue: {fileID: 0}
    requiredFlags:
    - foundMenuSecret
    - foundHiddenTombstone
    forbiddenFlags: []
    onChoiceSelected:
      m_PersistentCalls:
        m_Calls: []
  choicesAfterLineIndex: -1
  saveAfterDialogue: 1
  showChoicesAtEnd: 1
