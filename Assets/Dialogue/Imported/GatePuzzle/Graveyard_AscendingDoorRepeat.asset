    forbiddenFlags: []
    onChoiceSelected:
      m_PersistentCalls:
        m_Calls: []
  - choiceText: You took everything from me.
    nextDialogue: {fileID: 0}
    requiredFlags: []
    forbiddenFlags: []
    onChoiceSelected:
      m_PersistentCalls:
        m_Calls: []
  - choiceText: There's somewhere else I need to go.
    nextDialogue: {fileID: 0}
